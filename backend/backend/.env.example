# Copy to .env and fill in real values. Never commit the real .env file.

# --- Application ---
ENVIRONMENT=local
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# The backend connects with a restricted, RLS-bound role -- not the
# Postgres superuser. See infrastructure/db (added in the persistence step)
# for the role-provisioning migration.
DATABASE_URL=postgresql+asyncpg://appex_app:changeme@postgres:5432/appex

# --- Cache ---
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-value-never-commit-a-real-one
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Telegram ---
# MVP: single shared bot token. Obtain from @BotFather.
TELEGRAM_BOT_TOKEN=replace-with-the-real-bot-token

# --- AI module ---
AI_MODULE_BASE_URL=http://ai-module:8100

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
