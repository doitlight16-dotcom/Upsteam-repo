# APEX ASSET SUITE — ADIPEC Concierge Bot
# Переменные окружения для Vercel + Webhook архитектуры
# ────────────────────────────────────────────────────────
# Скопируйте этот файл в .env для локальной разработки:
#   cp .env.example .env
# Для Vercel — добавьте все переменные в:
#   Vercel Dashboard → Settings → Environment Variables

# ─── Telegram ───────────────────────────────────────────
BOT_TOKEN=1234567890:your_bot_token_from_botfather_here

# Секретный токен для защиты Webhook-эндпоинта.
# Генерация: openssl rand -hex 16
# Telegram будет добавлять его в заголовок X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=your_random_secret_32_chars_here

# ─── Vercel Deployment ──────────────────────────────────
# URL деплоя на Vercel (без слеша в конце).
# После деплоя Vercel покажет его в Dashboard.
VERCEL_URL=https://your-project-name.vercel.app

# ─── Web App ────────────────────────────────────────────
WEBAPP_URL=https://appex-adipec-concierge.vercel.app
SUPPORT_USERNAME=@appex_support

# ─── Google Sheets ──────────────────────────────────────
SPREADSHEET_ID=1szL5sNAQMN0c90kb9j8Z8Qiw3mZ6Kpmj3EaYsErO8Lw

# Содержимое credentials.json одной строкой (для Vercel)
# Способ получить: cat credentials.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Для локальной разработки можно использовать файл вместо JSON:
# CREDENTIALS_FILE=credentials.json

# ─── Upstash Redis (FSM состояния) ──────────────────────
# Получить на https://upstash.com → Create Database → Redis
# Используйте TLS-URL (начинается с rediss://)
UPSTASH_REDIS_URL=rediss://default:your_password@your-db-name.upstash.io:6379

# ─── Безопасность (CORS) ────────────────────────────────
# Домены, которым разрешено делать запросы к API.
# Несколько доменов — через запятую.
ALLOWED_ORIGINS=https://appex-adipec-concierge.vercel.app

# ─── Администратор ──────────────────────────────────────
ADMIN_CHAT_ID=

# ─── White-Label Admin Panel ────────────────────────────
# Секретный токен для доступа к админ-панели (Bearer auth).
# Генерация: openssl rand -hex 32
ADMIN_SECRET=your_admin_secret_here

# ─── AI Concierge (Google Gemini) ─────────────────────────
# API ключ от Google Gemini (OpenAI совместимый).
# Получить: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
